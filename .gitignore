# ===== 系統與編輯器 =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.swp
*~
.idea/
.vscode/
*.code-workspace

# ===== Swift(app)=====
.build/
build/
.swiftpm/
*.xcodeproj/xcuserdata/
DerivedData/
*.app/
*.dSYM/

# ===== Go =====
bin/
# server/scripts/build-local.sh 交叉編譯的 omixor-local
server/dist/
# go build ./cmd/omixor 在 web/ 底下產生的執行檔
web/omixor
*.test
*.out
coverage.*

# ===== Node / Vite(web/ui)=====
node_modules/
*.tsbuildinfo
npm-debug.log*
.vite/
# 建置出來的畫面:不進版控,只留空檔讓 go:embed 編得過(make build 會先 npm run build)
web/ui/dist/*
!web/ui/dist/.keep

# ===== 機密與本機設定 =====
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision
*.keychain*
# 匯入用的掛載點(docker compose),只留空資料夾
web/.import-empty/*
!web/.import-empty/.keep

# ===== 執行時的暫存與紀錄(資料本身在 ~/Library/Application Support,不在專案裡)=====
*.log
*.tmp
*.unreadable-*.json

# ===== Claude Code 預覽設定(含本機路徑)=====
.claude/launch.json

# core、server 編譯產生的執行檔
core/omixor
server/omixor-server
