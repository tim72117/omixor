  {"tool": "ops_voice_jobs", "args": {"id": "vj-99"}},
  {"tool": "ops_voice_jobs", "args": {"id": ""}, "note": "空字串也當成有給 id"},
  {"tool": "ops_voice_jobs", "args": {"id": 3}, "note": "數字 id 轉字串"},
  {"tool": "ops_voice_jobs", "args": {"id": "  VJ-2  "}, "note": "去頭尾空白"},
  {"tool": "ops_voice_submit", "args": {}, "note": "沒給腳本"},
  {"tool": "ops_voice_submit", "args": {"scripts": []}},
  {"tool": "ops_voice_submit", "args": {"scripts": "  , \n"}, "note": "只有分隔符號"},
  {"tool": "ops_voice_submit", "args": {"all": "true"}, "note": "all 是字串不算(as? Bool)"},
  {"tool": "ops_voice_submit", "args": {"all": false, "scripts": [], "limit": 3}},
  {"tool": "ops_voice_submit", "args": {"scripts": ["launch/2.1.voice.json"]}, "note": "產生出來的清單"},
  {"tool": "ops_voice_submit", "args": {"scripts": "launch/a.mix"}, "note": "自動補 .json 後是 .mix.json"},
  {"tool": "ops_voice_submit", "args": {"scripts": ["web/src/content/live/launch/b.voice"]}, "note": "去掉前綴、補 .json"},
  {"tool": "ops_voice_submit", "args": {"scripts": ["nope/x"]}, "note": "找不到腳本(OPS_SHUTTLE_PATH 指到空資料夾)"},
  {"tool": "ops_voice_submit", "args": {"scripts": ["web/src/content/live/nope/y.json, nope/z"]}, "note": "逗號分隔,第一份就錯"},
  {"tool": "ops_voice_submit", "args": {"scripts": [" nope/a.json\nlaunch/c.voice.json"]}, "note": "換行分隔,依序檢查"},
  {"tool": "ops_voice_submit", "args": {"scripts": [12]}, "note": "數字當腳本名稱"},
  {"tool": "ops_voice_submit", "args": {"scripts": ["x.voice.json"], "dry_run": true}, "note": "dry_run 在執行 npm 之前就檢查失敗(不會跑外部程式)"},
  {"tool": "ops_voice_submit", "args": {"dry_run": true}, "note": "dry_run 沒給腳本,也在 npm 之前失敗"},
  {"tool": "ops_voice_submit", "args": {"scripts": ["nope/q"], "dry_run": "yes"}, "note": "dry_run 是字串不算,走一般送出的檢查"},
  {"tool": "ops_voice_jobs", "note": "上面都失敗,還是空的"}
