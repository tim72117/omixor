{
  "note": "連線與外部服務(GitHub、GCP、網站訪客)。只比對不需登入、不會連外的路徑:未登入時每個工具的錯誤訊息、參數錯誤訊息。Swift 比對實例用正式鑰匙圈,所以兩邊都要用預先放好空連線的資料夾啟動,啟動時才不會在背景向 evoleap 確認登入:for d in S G; do mkdir -p /tmp/ops-ext-$d/orgs/default && echo '[]' > /tmp/ops-ext-$d/orgs/default/connections.json; done; conformance/run_swift.sh 3821 /tmp/ops-ext-S; conformance/run_go.sh 3822 5221 /tmp/ops-ext-G;不要在這裡加會真的連外的呼叫。",
  "steps": [
    {"tool": "github", "note": "沒有 GitHub 連線"},
    {"tool": "github", "args": {"refresh": true, "repo": "not a repo", "limit": 0}},
    {"tool": "github_runs", "args": {"repo": "not a repo"}},
    {"tool": "github_runs", "args": {"status": "failure", "branch": "main"}},
    {"tool": "github_run", "args": {}},
    {"tool": "github_run", "args": {"id": 7, "log": true}},
    {"tool": "github_pull", "args": {}},
    {"tool": "github_pull", "args": {"number": 12, "repo": "a/b"}},
    {"tool": "gcp", "note": "沒有 Google Cloud 連線"},
    {"tool": "gcp", "args": {"refresh": true, "service": "shuttle-server", "job": "x"}},
    {"tool": "gcp_logs", "args": {"severity": "LOUD"}},
    {"tool": "gcp_logs", "args": {"service": "shuttle-server", "hours": 5000}},
    {"tool": "gcp_metrics", "args": {}},
    {"tool": "gcp_metrics", "args": {"service": "shuttle-server", "hours": 0}},
    {"tool": "site_visitors", "args": {"range": "2y"}, "note": "range 錯誤在連線前就擋"},
    {"tool": "site_visitors", "args": {"range": "ALL"}},
    {"tool": "site_visitors", "args": {"range": 7}},
    {"tool": "site_visitors", "args": {"range": "7d", "connection": "nope"}, "note": "找不到連線,不會連外"},
    {"tool": "site_visitors", "args": {"connection": "evoleap"}, "note": "資料夾裡沒有連線(空的 connections.json),不會連外"}
  ]
}
