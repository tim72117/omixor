# 複製成 .env 再填。.env 不要 commit。
# 變數以前叫 OPS_*(OPS_SECRET_KEY…),舊的 .env 照樣能用,建議改成下面的 OMIXOR_*。
POSTGRES_PASSWORD=
# openssl rand -base64 32;用來加密存在資料庫裡的 token 與密碼,換掉的話已存的會解不開
OMIXOR_SECRET_KEY=
# macOS App(Swift 版)開著時 3765 會被占用,可以改成 3766
OMIXOR_MCP_HOST_PORT=3765
# 反向代理的網域(逗號分隔)
OMIXOR_WEB_HOSTS=
# 要匯入的資料夾,例如 /Users/<你>/Library/Application Support/Ops
OMIXOR_IMPORT_DIR=
